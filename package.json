{
  "name": "signsafe",
  "scripts": {
    "build": "next build",
    "ci": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:env": "tsx scripts/check-env.ts",
    "setup:demo": "tsx scripts/setup-demo.ts",
    "scenarios:check": "tsx scripts/scenarios-check.ts",
    "fixtures:save": "tsx scripts/save-fixtures.ts",
    "samples:print": "tsx scripts/print-samples.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts"
  },
  "description": "SignSafe: check what a Solana transaction will do before you sign it",
  "keywords": [
    "kit",
    "signsafe",
    "react",
    "solana-kit",
    "tailwind",
    "typescript"
  ],
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@solana-program/compute-budget": "^0.20.0",
    "@solana-program/memo": "^0.15.0",
    "@solana-program/system": "^0.14.0",
    "@solana-program/token": "^0.17.0",
    "@solana-program/token-2022": "^0.20.1",
    "@solana/kit": "^8.5.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/kit-plugin-wallet": "^0.20.0",
    "@solana/react": "^8.5.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "swr": "^2.5.1",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@wallet-standard/wallet": "^1.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
